# ─────────────────────────────────────────────────────────────────────────────
# Secret Manager — Environment Configuration Reference
#
# Copy to .env and fill in real values.  NEVER commit .env to version control.
# All values here are validated at startup by app/config.py (Pydantic Settings).
# Missing required values raise a clear startup error — fail-fast over silent bugs.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="SecretManager"
APP_ENV="development"          # development | staging | production
APP_DEBUG="false"              # Never true in production
APP_HOST="0.0.0.0"
APP_PORT="8000"
APP_WORKERS="4"

# ── Security ─────────────────────────────────────────────────────────────────
# JWT signing secret — min 64 bytes of entropy, generated with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY="CHANGE_ME_generate_64_byte_random_hex_string_here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="15"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"
JWT_ISSUER="secret-manager"
JWT_AUDIENCE="secret-manager-api"

# ── Master Encryption Key (MEK) ───────────────────────────────────────────────
# Used ONLY to wrap/unwrap Data Encryption Keys (DEKs).
# Never used to directly encrypt user data (envelope encryption pattern).
# 32 bytes → AES-256 key, URL-safe base64:
#   python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY="CHANGE_ME_32_byte_base64url_encoded_master_key"

# HMAC key for audit log chain integrity verification.
# 64 bytes, hex-encoded:
#   python -c "import secrets; print(secrets.token_hex(64))"
AUDIT_HMAC_KEY="CHANGE_ME_64_byte_hex_encoded_audit_hmac_key"

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_DB="secretmanager"
POSTGRES_USER="smgr"
POSTGRES_PASSWORD="CHANGE_ME_strong_db_password"
DATABASE_URL="postgresql+asyncpg://smgr:CHANGE_ME_strong_db_password@postgres:5432/secretmanager"
DATABASE_POOL_SIZE="20"
DATABASE_MAX_OVERFLOW="10"

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"
REDIS_RATE_LIMIT_DB="1"      # Separate DB for rate limit counters
REDIS_CACHE_DB="2"           # Separate DB for secret cache
REDIS_LOCK_DB="3"            # Separate DB for distributed locks

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL="redis://redis:6379/4"
CELERY_RESULT_BACKEND="redis://redis:6379/5"

# ── Argon2id KDF Parameters ───────────────────────────────────────────────────
# OWASP recommends: time_cost>=1, memory_cost>=64MB, parallelism>=4
# Tune based on your hardware — benchmark with scripts/benchmark_argon2.py
ARGON2_TIME_COST="3"
ARGON2_MEMORY_COST="65536"   # 64 MiB
ARGON2_PARALLELISM="4"
ARGON2_HASH_LENGTH="32"

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE="5"       # Login attempts per IP
RATE_LIMIT_API_PER_MINUTE="100"      # General API calls per user
RATE_LIMIT_WRITE_PER_MINUTE="20"     # Secret write ops per user
RATE_LIMIT_GLOBAL_PER_MINUTE="1000"  # Global per-IP limit

# ── Secret Cache ─────────────────────────────────────────────────────────────
SECRET_CACHE_TTL_SECONDS="300"       # 5 min cache for frequently-read secrets
SECRET_CACHE_ENABLED="true"

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Used ONLY by scripts/bootstrap.py to create the first super_admin.
# Clear these env vars after bootstrap. Do not leave in production env.
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME_strong_admin_password_min_16_chars"

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
CORS_ALLOW_CREDENTIALS="true"
